<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Base OMEGA</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Rajdhani:wght@500;700&display=swap">
<style>
:root{--bg:#04080f;--pn:#0a1424;--bd:#1b4560;--cy:#5ee6ff;--ice:#d6f1ff;--mut:#7f9db5;--warn:#ffb347;--bad:#ff5468;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{background:var(--bg);scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(1100px 520px at 50% -8%,#0e2a4a,var(--bg) 62%) var(--bg);color:var(--ice);font:500 17px/1.4 Rajdhani,"Segoe UI",system-ui,sans-serif;min-height:100vh}
body::before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(94,230,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(94,230,255,.035) 1px,transparent 1px);background-size:42px 42px}
#wrap{position:relative;max-width:900px;margin:0 auto;padding:14px}
header{display:flex;align-items:center;gap:14px;margin-bottom:12px}
#lg{height:58px;width:auto;filter:drop-shadow(0 0 8px rgba(94,230,255,.55))}
h1{font:700 1.55rem Orbitron,"Segoe UI",sans-serif;letter-spacing:.34em;margin:0;text-shadow:0 0 14px rgba(94,230,255,.6)}
.sub{color:var(--mut);letter-spacing:.08em}
#hero{position:relative;border:1px solid var(--bd);border-radius:6px;overflow:hidden;margin-bottom:12px;box-shadow:0 0 28px rgba(94,230,255,.14);--pwr:.6;--o2:.7;--wtr:.7;--rad:0}
#hero svg{display:block;width:100%;height:auto;min-height:230px}
.hud{position:absolute;top:10px;left:12px;right:12px;display:flex;justify-content:space-between;gap:8px;font:700 .95rem Orbitron,sans-serif;letter-spacing:.12em;text-shadow:0 0 8px #000}
#hf{color:var(--warn)}
.cap{position:absolute;left:12px;bottom:8px;font-size:.8rem;color:var(--mut);letter-spacing:.1em}
.pn{background:linear-gradient(180deg,rgba(14,32,54,.88),rgba(8,16,30,.9));border:1px solid var(--bd);border-left:3px solid var(--cy);border-radius:4px;padding:12px;margin-bottom:12px}
.top{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:6px}
.day{font:700 1.15rem Orbitron,sans-serif;letter-spacing:.08em}
.hint{font-size:.85rem;color:var(--mut)}
.grid{display:grid;gap:12px}
.big{grid-template-columns:repeat(auto-fit,minmax(160px,1fr))}
.small{grid-template-columns:repeat(auto-fit,minmax(120px,1fr));margin-top:12px}
.l{display:flex;justify-content:space-between;align-items:baseline}
.l b{font:700 1.1rem Orbitron,sans-serif}
.small .l{font-size:.9rem;color:var(--mut)}.small .l b{font-size:.9rem;color:var(--ice)}
.t{position:relative;height:13px;background:#07121f;border:1px solid #17384f;border-radius:3px;overflow:hidden;margin-top:4px}
.small .t{height:8px}
.t i{display:block;height:100%;transition:width .5s}
.t::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 9px,#07121f 9px 11px)}
.ok{background:linear-gradient(90deg,#1ec9a0,#35f0b0);box-shadow:0 0 10px #35f0b0}
.warn{background:linear-gradient(90deg,#ff9d2e,#ffd166);box-shadow:0 0 10px #ffb347}
.bad{background:linear-gradient(90deg,#ff3b57,#ff7a6e);box-shadow:0 0 10px #ff5468}
.ev{border-left-color:var(--warn)}.ev.fl{border-left-color:var(--bad)}
.why{color:var(--cy);font-weight:700}
.ctl{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:8px;margin-top:8px}
button{font:inherit;cursor:pointer;color:var(--ice);text-align:left;min-height:60px;padding:10px 12px;background:rgba(94,230,255,.05);border:1px solid var(--bd);border-radius:3px;clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));transition:.15s}
button:hover{background:rgba(94,230,255,.14);border-color:var(--cy);box-shadow:0 0 14px rgba(94,230,255,.3)}
button:focus-visible{outline:3px solid var(--cy);outline-offset:2px}
button b{display:block}button span{font-size:.85rem;color:var(--mut)}
button.on{background:rgba(94,230,255,.2);border-color:var(--cy)}
button.go{width:100%;margin-top:12px;text-align:center;font:700 1.05rem Orbitron,sans-serif;letter-spacing:.2em;color:#04202b;background:linear-gradient(90deg,#2bd6ff,#7af0ff);border:0}
.foot{font-size:.8rem;color:var(--mut)}
.st{animation:tw 3s ease-in-out infinite}
@keyframes tw{50%{opacity:.15}}
.win{opacity:calc(.12 + var(--pwr)*.88);transition:opacity .6s}
.flick .win{animation:fk .3s infinite alternate}@keyframes fk{to{opacity:.08}}
.bc{animation:fk 1.4s infinite alternate}
.rv{animation:rv 50s linear infinite alternate}@keyframes rv{to{transform:translateX(-330px)}}
.tk{transform-box:fill-box;transform-origin:50% 100%;transition:transform .6s}
.sh{opacity:0;transition:opacity .5s;stroke-dasharray:5 7;animation:sd 5s linear infinite}
.shield-on .sh{opacity:1}@keyframes sd{to{stroke-dashoffset:-96}}
.fl-l{opacity:0}.flare .fl-l{animation:fa 3s}@keyframes fa{0%,100%{opacity:0}15%,75%{opacity:1}}
.fl-l line{stroke-dasharray:8 12;animation:rs .7s linear infinite}@keyframes rs{to{stroke-dashoffset:-20}}
.pls{opacity:0}.flare .pls{animation:pa 3s}@keyframes pa{0%{opacity:0}20%{opacity:.3}100%{opacity:0}}
.vg{opacity:calc(var(--rad)*.85);transition:opacity .6s}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
<body>
<div id="wrap">
<header><img id="lg" alt="Base OMEGA logo" src="data:image/png;base64,"><div><h1>BASE OMEGA</h1><div class="sub">Moon outpost mission trainer</div></div></header>
<div id="hero"><svg id="sc" viewBox="0 0 800 320" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Animated simulated view of Base OMEGA on the Moon">
<defs>
<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#02050c"/><stop offset="1" stop-color="#14224a"/></linearGradient>
<linearGradient id="gd" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#46536e"/><stop offset="1" stop-color="#121a2b"/></linearGradient>
<radialGradient id="er" cx=".35" cy=".35"><stop offset="0" stop-color="#8fd8ff"/><stop offset=".6" stop-color="#2a6fd0"/><stop offset="1" stop-color="#0a1f55"/></radialGradient>
<radialGradient id="dm" cx=".5" cy="1" r="1"><stop offset=".3" stop-color="#5ee6ff" stop-opacity=".05"/><stop offset="1" stop-color="#5ee6ff" stop-opacity=".38"/></radialGradient>
<radialGradient id="vgd" cx=".5" cy=".5" r=".75"><stop offset=".45" stop-color="#ff2a44" stop-opacity="0"/><stop offset="1" stop-color="#ff2a44" stop-opacity=".75"/></radialGradient>
<clipPath id="up"><rect width="800" height="252"/></clipPath>
</defs>
<rect width="800" height="320" fill="url(#sky)"/>
<g id="stars"></g>
<circle cx="40" cy="10" r="70" fill="#ffd9a0" opacity=".16"/>
<circle cx="665" cy="72" r="34" fill="url(#er)"/><circle cx="665" cy="72" r="38" fill="none" stroke="#5ee6ff" stroke-opacity=".3"/>
<path d="M0 252 Q200 226 400 240 T800 236 V320 H0Z" fill="url(#gd)"/>
<ellipse cx="130" cy="285" rx="46" ry="9" fill="#0d1423"/><ellipse cx="640" cy="288" rx="60" ry="10" fill="#0d1423"/><ellipse cx="520" cy="270" rx="24" ry="5" fill="#0d1423"/>
<g class="rv"><rect x="540" y="258" width="26" height="9" rx="3" fill="#8aa0bd"/><circle cx="546" cy="269" r="4" fill="#2a3448"/><circle cx="561" cy="269" r="4" fill="#2a3448"/></g>
<g stroke="#5ee6ff" stroke-width="1.2" fill="#13233c">
<rect x="250" y="206" width="92" height="46" rx="14"/><rect x="458" y="206" width="92" height="46" rx="14"/>
<rect x="338" y="224" width="22" height="12"/><rect x="440" y="224" width="22" height="12"/>
<rect x="212" y="216" width="22" height="36" rx="4" fill="none"/><rect x="566" y="216" width="22" height="36" rx="4" fill="none"/>
</g>
<rect class="tk" x="214" y="218" width="18" height="32" fill="#4db8ff" style="transform:scaleY(var(--o2))"/>
<rect class="tk" x="568" y="218" width="18" height="32" fill="#35f0b0" style="transform:scaleY(var(--wtr))"/>
<g fill="#ffe9a8"><rect class="win" x="266" y="222" width="14" height="9" rx="2"/><rect class="win" x="290" y="222" width="14" height="9" rx="2"/><rect class="win" x="314" y="222" width="14" height="9" rx="2"/><rect class="win" x="474" y="222" width="14" height="9" rx="2"/><rect class="win" x="498" y="222" width="14" height="9" rx="2"/><rect class="win" x="522" y="222" width="14" height="9" rx="2"/></g>
<path d="M340 252 A60 60 0 0 1 460 252Z" fill="url(#dm)" stroke="#5ee6ff" stroke-width="1.5"/>
<rect x="394" y="208" width="12" height="44" fill="#2b4a6b"/><circle class="bc" cx="400" cy="203" r="4" fill="#ff5468"/>
<rect class="win" x="380" y="228" width="40" height="8" rx="2" fill="#ffe9a8"/>
<g stroke="#8aa0bd" stroke-width="2" fill="none"><path d="M140 252 V226 M120 214 Q140 236 160 214"/><path d="M620 252 V240 M680 252 V240 M740 252 V240"/></g>
<g fill="#153a8a" stroke="#5ee6ff" stroke-width="1"><path d="M606 240 L634 212 H692 L664 240Z"/><path d="M666 240 L694 212 H752 L724 240Z"/></g>
<g clip-path="url(#up)"><ellipse class="sh" cx="400" cy="252" rx="190" ry="120" fill="rgba(94,230,255,.07)" stroke="#5ee6ff" stroke-width="2"/></g>
<g class="fl-l" stroke="#ffb347" stroke-width="2"><line x1="40" y1="14" x2="300" y2="150"/><line x1="40" y1="14" x2="360" y2="120"/><line x1="40" y1="14" x2="440" y2="110"/><line x1="40" y1="14" x2="520" y2="150"/><line x1="40" y1="14" x2="250" y2="200"/></g>
<rect class="pls" width="800" height="320" fill="#ff3b4e"/>
<rect class="vg" width="800" height="320" fill="url(#vgd)"/>
</svg>
<div class="hud"><span id="hd">Day 1 / 10</span><span id="hf"></span></div>
<div class="cap">Simulated view of Base OMEGA</div>
</div>
<div id="app"></div>
<p class="foot">Solar flare dates and classes come from NASA space weather records (DONKI). This is a saved copy, not live data. Game numbers are simplified for learning. Code written with AI assistance.</p>
</div>
<script>
var FL=[["28 Oct 2021","X1.0",1.0],["30 Mar 2022","X1.3",1.3],["14 Dec 2023","X2.8",2.8],["7 Mar 2012","X5.4",5.4],["11 May 2024","X5.8",5.8],["22 Feb 2024","X6.3",6.3],["10 Sep 2017","X8.2",8.2],["14 May 2024","X8.7",8.7],["3 Oct 2024","X9.0",9.0],["6 Sep 2017","X9.3",9.3]];
var QN=["Low","Normal","High"],MN=["Normal work","Science (earns funding)","Shelter (hide from radiation)"],ON=["None","Food","Oxygen","Water"],OC=[0,40,30,30],OD=[0,3,2,2],OA=[0,40,30,30];
var S;
function start(){S={day:1,o2:70,water:70,food:60,power:60,funds:100,rad:0,hap:70,eq:100,quota:1,mk:false,burn:false,mode:0,order:0,ships:[],msg:"Welcome, commander! You command Base OMEGA on the Moon for 10 days. Every choice costs something. Choose a plan, then press End day.",flare:null,end:null};draw()}
function cl(v){return Math.max(0,Math.min(100,v))}
function col(v,inv){var g=inv?100-v:v;return g<25?"bad":g<50?"warn":"ok"}
function M(n,v,inv,hint){return '<div><div class="l"><span>'+n+'</span><b>'+Math.round(v)+'</b></div><div class="t"><i class="'+col(v,inv)+'" style="width:'+cl(v)+'%"></i></div>'+(hint?'<div class="hint">'+hint+'</div>':'')+'</div>'}
function setHero(){var e=document.getElementById("hero"),s=S,p=e.style;
p.setProperty("--pwr",cl(s.power)/100);p.setProperty("--o2",Math.max(.04,cl(s.o2)/100));p.setProperty("--wtr",Math.max(.04,cl(s.water)/100));p.setProperty("--rad",cl(s.rad)/100);
e.classList.toggle("shield-on",s.mode==2&&!s.end);e.classList.toggle("flick",s.eq<40||s.power<15);
document.getElementById("hd").textContent="Day "+Math.min(s.day,10)+" / 10";
document.getElementById("hf").textContent=s.flare?"Solar flare "+s.flare[1]+" · "+s.flare[0]:"";
if(s.fresh){s.fresh=0;e.classList.remove("flare");void e.offsetWidth;e.classList.add("flare")}}
function draw(){
var s=S,h='';
if(s.end){h+='<div class="pn"><div class="day">'+(s.end.win?"Mission complete":"Mission failed")+'</div><p>'+s.end.text+'</p><p class="why">'+s.end.why+'</p><button class="go" onclick="start()">Play again</button></div>'}
else{
h+='<div class="pn top"><span class="day">Commander’s console</span><span class="hint">Funding: '+s.funds+' credits</span></div>';
h+='<div class="pn"><div class="grid big">'+M("Oxygen",s.o2,0,"Air to breathe")+M("Water",s.water,0,"80% recycled")+M("Food",s.food,0,"")+M("Power",s.power,0,"")+'</div><div class="grid small">'+M("Radiation",s.rad,1,"")+M("Happiness",s.hap,0,"")+M("Equipment",s.eq,0,"")+'</div></div>';
h+='<div class="pn ev'+(s.flare?' fl':'')+'">'+s.msg+'</div>';
var ar=s.ships.map(function(x){return ON[x[0]]+" in "+x[1]+" day"+(x[1]>1?"s":"")}).join(", ");
h+='<div class="pn"><b>Your plan for today</b><div class="ctl">';
h+='<button onclick="S.quota=(S.quota+1)%3;draw()"><b>Food quota: '+QN[s.quota]+'</b><span>Higher makes the crew happier but uses food faster</span></button>';
h+='<button class="'+(s.mk?'on':'')+'" onclick="S.mk=!S.mk;draw()"><b>Make oxygen from water: '+(s.mk?"On":"Off")+'</b><span>Uses 12 water for 10 oxygen</span></button>';
h+='<button class="'+(s.burn?'on':'')+'" onclick="S.burn=!S.burn;draw()"><b>Burn oxygen for power: '+(s.burn?"On":"Off")+'</b><span>Uses 10 oxygen for 20 power</span></button>';
h+='<button onclick="S.mode=(S.mode+1)%3;draw()"><b>Mode: '+MN[s.mode]+'</b><span>Science and shelter both use 15 power</span></button>';
h+='<button onclick="S.order=(S.order+1)%4;draw()"><b>Order supplies: '+ON[s.order]+'</b><span>'+(s.order?OC[s.order]+" credits, arrives in "+OD[s.order]+" days":"Ships take days to arrive")+'</span></button></div>';
if(ar)h+='<p class="hint">On the way: '+ar+'</p>';
h+='<button class="go" onclick="endDay()">End day</button></div>'}
document.getElementById("app").innerHTML=h;setHero()}

function endDay(){
var s=S,m=[],eff=s.eq/100,lesson="",f=null;
s.flare=null;
if(s.order&&s.funds>=OC[s.order]){s.funds-=OC[s.order];s.ships.push([s.order,OD[s.order]]);m.push("You ordered "+ON[s.order].toLowerCase()+".")}else if(s.order){m.push("Not enough funding to order "+ON[s.order].toLowerCase()+".")}
s.food-=[8,12,18][s.quota];s.hap+=[-5,0,8][s.quota];
s.o2-=10;s.water-=10;s.power+=14-12;
if(s.mode>0)s.power-=15;
if(s.burn){s.o2-=10;s.power+=20}
s.water+=8*eff;
if(s.mk&&s.water>=12){s.water-=12;s.o2+=10*eff}
s.funds+=5+(s.mode==1?25:0);
if(Math.random()<.45){f=FL[Math.floor(Math.random()*FL.length)];var hit=(10+f[2]*4)*(s.mode==2?.3:1);s.rad+=hit;s.flare=f;s.fresh=1;
m.push("Real solar flare: class "+f[1]+" on "+f[0]+". Radiation +"+Math.round(hit)+".");
lesson="Strong solar flares send out radiation that can harm astronauts. Real crews shelter in shielded areas.";}
else m.push("A quiet day in space.");
s.rad-=(s.mode==2?15:6);
if(s.power<15){s.eq-=20;m.push("Power is low, so equipment is shutting down.");lesson=lesson||"Without power, the machines that recycle water and make oxygen stop working."}else s.eq+=5;
s.hap-=2;if(s.rad>60)s.hap-=8;if(s.power<20)s.hap-=8;
s.ships.forEach(function(x){x[1]--});
s.ships=s.ships.filter(function(x){if(x[1]<=0){var k=["","food","o2","water"][x[0]];s[k]=s[k]+OA[x[0]];m.push("A supply ship arrived with "+ON[x[0]].toLowerCase()+".");return false}return true});
if(!lesson){lesson=s.food<25?"Real supply ships take days or months to arrive, so planners order food long before they need it.":s.o2<30?"Oxygen can be made from water, but that uses up water and power.":"The International Space Station recycles over 90% of its water. Your base recycles 80% while the equipment works."}
s.power=cl(s.power);s.rad=cl(s.rad);s.eq=cl(s.eq);s.hap=cl(s.hap);s.funds=Math.round(s.funds);s.food=s.food;
var bad=null;
if(s.o2<=0)bad=["The crew ran out of oxygen.","Oxygen is the one thing the crew cannot live without, even for minutes."];
else if(s.food<=0)bad=["The crew ran out of food.","Food must be ordered days ahead, because supply ships take time to arrive."];
else if(s.water<=0)bad=["The crew ran out of water.","Water is used for drinking and for making oxygen, so recycling it is vital."];
else if(s.rad>=100)bad=["Radiation got too high for the crew.","Space radiation is a major health risk on long missions."];
else if(s.hap<=0)bad=["The crew became too unhappy to continue.","Mission planners must care for crew morale, not just machines."];
s.o2=cl(s.o2);s.water=cl(s.water);s.food=cl(s.food);
if(bad){s.end={win:false,text:bad[0]+" You lasted "+s.day+" day"+(s.day>1?"s":"")+".",why:bad[1]}}
else if(s.day>=10){s.end={win:true,text:"Your crew survived all 10 days with "+s.funds+" credits left and happiness at "+Math.round(s.hap)+".",why:"Real mission planners balance power, air, water, food and radiation every day, just like you did."}}
else{s.day++;s.msg=m.join(" ")+' <span class="why">'+lesson+'</span>'}
draw()}
start();
var g=document.getElementById("stars"),q="";for(var i=0;i<70;i++){q+='<circle class="st" cx="'+(Math.random()*800).toFixed(0)+'" cy="'+(Math.random()*220).toFixed(0)+'" r="'+(Math.random()*1.2+.3).toFixed(1)+'" fill="#cfeeff" style="animation-delay:-'+(Math.random()*3).toFixed(1)+'s"/>'}g.innerHTML=q;
</script>
</body>
</html>
